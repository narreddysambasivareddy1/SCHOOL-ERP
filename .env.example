# Copy to .env and fill in values. Never commit .env to source control.

POSTGRES_DB=schoolerp
POSTGRES_USER=schoolerp
POSTGRES_PASSWORD=change_me_strong_password

JWT_SECRET=change_me_at_least_32_chars_long_secret_key
JWT_ISSUER=schoolerp
JWT_AUDIENCE=schoolerp-clients
JWT_EXPIRY_MINUTES=60

ASPNETCORE_ENVIRONMENT=Production
INTEGRATIONS_MODE=Sandbox

# Dummy placeholders — replace with school-issued credentials before going live.
# SMTP_HOST=smtp.school-placeholder.invalid
# SMTP_USERNAME=noreply@school-placeholder.invalid
# SMTP_PASSWORD=REPLACE_WITH_SCHOOL_SMTP_PASSWORD
# SMS_API_KEY=DUMMY_SMS_API_KEY_REPLACE_ME
# WHATSAPP_ACCESS_TOKEN=DUMMY_WHATSAPP_ACCESS_TOKEN_REPLACE_ME
# GOOGLE_MAPS_API_KEY=DUMMY_GOOGLE_MAPS_API_KEY_REPLACE_ME
# RAZORPAY_KEY_ID=rzp_test_DUMMYKEYID
# RAZORPAY_KEY_SECRET=DUMMY_RAZORPAY_KEY_SECRET_REPLACE_ME

HTTP_PORT=80
HTTPS_PORT=443
